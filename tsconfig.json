{
  "compilerOptions": {
    "target": "esnext",
    "module": "Node16",
    "lib": [
      "esnext"
    ],
    "jsx": "react-native",
    "strict": false,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "moduleResolution": "Node16",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "exclude": [
    "node_modules"
  ],
  "extends": "expo/tsconfig.base"
}
